{
  "name": "@ci/site",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && astro dev",
    "build": "node scripts/sync-content.mjs --roadmap-live && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "node scripts/sync-content.mjs && astro sync && tsc --noEmit",
    "links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
