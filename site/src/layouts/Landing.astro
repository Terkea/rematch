---
import "../styles/fonts.css";
import "../styles/generated/tokens.css";
import "../styles/landing.css";
import "../styles/diagram.css";
import { href, REPO_URL } from "../data/site";

// The header carries the wordmark alone: "Rematch" in Literata italic, capital R.

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const card = new URL(href("og.png"), Astro.site);
---

<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={href("media/rematch-hook.jpg")} as="image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Rematch logo, a boy with his chess board and his dad's hand on his shoulder, beside: Rematch, chess improver. Stop losing to the same move." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={card} />
    <meta property="og:video" content={new URL(href("media/rematch.mp4"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    {/* The docs' theme choice (Starlight's key) applies here too, before first paint. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch {}
        const dark =
          stored === "dark" ||
          ((stored === null || stored === "auto" || stored === "") &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="wordmark" href={href("")} aria-label="Rematch, chess improver, home">
          <span class="wordmark-name">Rematch</span>
        </a>
        <nav aria-label="Main" class="header-nav">
          <a class="nav-wide" href="#features">Features</a>
          <a class="nav-wide" href="#how-it-works">How it works</a>
          <a class="nav-wide" href="#roadmap">Roadmap</a>
          <a class="nav-wide" href="#contribute">Contribute</a>
          <a href={href("docs/getting-started/")}>Docs</a>
          <a href={REPO_URL}>GitHub</a>
          <button type="button" class="theme-toggle" data-theme-toggle>
            <span data-theme-label>Night</span>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <p class="footer-name">Rematch, chess improver</p>
        <p class="footer-note">
          Open source under the AGPL-3.0. Not affiliated with chess.com or Lichess. Analysis by
          Stockfish (GPL-3.0).
        </p>
        <nav aria-label="Footer" class="footer-nav">
          <a href={href("docs/getting-started/")}>Docs</a>
          <a href={href("docs/decisions/")}>Decision log</a>
          <a href={`${REPO_URL}/blob/main/LICENSE`}>Licence</a>
          <a href={`${REPO_URL}/blob/main/CODE_OF_CONDUCT.md`}>Code of conduct</a>
          <a href={`${REPO_URL}/blob/main/SECURITY.md`}>Security</a>
        </nav>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const label = document.querySelector<HTMLElement>("[data-theme-label]");
      const sync = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        if (label) label.textContent = dark ? "Day" : "Night";
        button?.setAttribute("aria-label", dark ? "Switch to day" : "Switch to night");
      };
      sync();
      button?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch {
          // storage unavailable: the choice lasts for this page
        }
        sync();
      });
    </script>
  </body>
</html>
