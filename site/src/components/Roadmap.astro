---
// The landing page's roadmap: Now, Next and Later, one column each, from GitHub's milestones and
// epics (src/data/roadmap.ts, ADR 0099).
import { epicName, HORIZONS, milestonesIn, progressText } from "../data/roadmap";
import { GOOD_FIRST_ISSUES_URL, href, REPO_URL } from "../data/site";
---

<div class="roadmap">
  {
    HORIZONS.map((h) => (
      <section class="roadmap-group" aria-labelledby={`roadmap-${h.id}`}>
        <h3 id={`roadmap-${h.id}`} class="roadmap-title">
          {h.title}
        </h3>
        <ol class="roadmap-list" role="list">
          {milestonesIn(h.id).map((m) => (
            <li>
              <a class="roadmap-item" href={m.url}>
                {m.title}
              </a>
              <span class="roadmap-detail">{m.description}</span>
              <ul class="roadmap-epics" role="list">
                {m.epics.map((e) => (
                  <li>
                    {e.url ? <a href={e.url}>{epicName(e.title)}</a> : epicName(e.title)}
                    <span class="roadmap-progress">
                      {progressText(e.done, e.total, "sub-issue")}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>
<p class="roadmap-more">
  <a href={`${REPO_URL}/milestones`}>Every milestone on GitHub</a>{" · "}
  <a href={GOOD_FIRST_ISSUES_URL}>Good first issues</a>{" · "}
  <a href={href("docs/roadmap/")}>What has shipped</a>
</p>
