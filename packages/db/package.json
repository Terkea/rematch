{
  "name": "@ci/db",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "development": {
        "types": "./src/generated/schema.ts",
        "default": "./src/generated/schema.ts"
      },
      "types": "./dist/generated/schema.d.ts",
      "default": "./dist/generated/schema.js"
    },
    "./generated/relations": {
      "development": {
        "types": "./src/generated/relations.ts",
        "default": "./src/generated/relations.ts"
      },
      "types": "./dist/generated/relations.d.ts",
      "default": "./dist/generated/relations.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "db:pull": "drizzle-kit pull --config drizzle.pull.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0"
  }
}
