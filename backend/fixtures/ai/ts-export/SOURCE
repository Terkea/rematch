How the export ran: Node's type stripping on a throwaway copy of the m3 checkout (mounted
read-only, so the host node_modules stay untouched). Only the JSON is committed.

  # export.mts (copied into /w/packages/ai)
  import { z } from "zod";
  import { zodOutputFormat } from "@anthropic-ai/sdk/helpers/zod";
  import { CoachingInput } from "./src/input/schema.ts";
  import { ReportSectionEnvelope } from "./src/output/report-schema.ts";
  const source = "m3/base@4ff8220";
  const schema = process.argv[2] === "input"
    ? z.toJSONSchema(CoachingInput)
    : zodOutputFormat(ReportSectionEnvelope).schema;
  process.stdout.write(JSON.stringify({ source, schema }, null, 2) + "\n");

  # run.sh
  set -e
  mkdir /w
  cd /src && tar --exclude=node_modules --exclude=.git -cf - . | tar -xf - -C /w
  cd /w && corepack enable && pnpm install --frozen-lockfile >&2
  cd /w/packages/ai
  # Type stripping does not map ".js" specifiers to ".ts" sources: rewrite them in the copy.
  find src -name '*.ts' -exec sed -i -E 's#(from "\.{1,2}/[^"]+)\.js"#\1.ts"#' {} +
  cp /scripts/export.mts .
  node --experimental-strip-types export.mts input > /out/coaching-input.schema.json
  node --experimental-strip-types export.mts envelope > /out/report-section-envelope.schema.json

  docker run --rm -v <m3 checkout>:/src:ro -v <script dir>:/scripts:ro -v <out dir>:/out \
    node:22.23.5-slim sh /scripts/run.sh

Refresh: rerun against the new m3 commit, update the commit, date and sha256 values above, then
run `cargo test -p ai --test input_shape`.
