{
  "$defs": {
    "Adherence": {
      "additionalProperties": false,
      "description": "Practice done against plan this week; `null` in the input when nothing was planned.",
      "properties": {
        "minutesDone": {
          "minimum": 0,
          "type": "integer"
        },
        "minutesPlanned": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "minutesDone",
        "minutesPlanned"
      ],
      "type": "object"
    },
    "AreaId": {
      "description": "One of the seven coaching areas (zod `AreaId`).",
      "enum": [
        "openings",
        "middlegame",
        "endgame",
        "tactics",
        "calculation",
        "time",
        "mindset"
      ],
      "type": "string"
    },
    "BandId": {
      "description": "Rating band on the Lichess-equivalent scale (zod `BandId`).",
      "enum": [
        "B0",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5"
      ],
      "type": "string"
    },
    "Basis": {
      "additionalProperties": false,
      "properties": {
        "analysedGames": {
          "description": "Games with engine analysis, the evidence window size.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "backfillComplete": {
          "description": "Whether the full history import finished.",
          "type": "boolean"
        },
        "importedGames": {
          "description": "Games imported from the platform (>= `analysedGames`).",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "windowEnd": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "windowStart": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        }
      },
      "required": [
        "analysedGames",
        "backfillComplete",
        "importedGames",
        "windowEnd",
        "windowStart"
      ],
      "type": "object"
    },
    "CandidateCause": {
      "additionalProperties": false,
      "description": "A correlated possible cause of a change, never proven.",
      "properties": {
        "after": {
          "$ref": "#/$defs/CauseValue",
          "description": "Value after the change point."
        },
        "before": {
          "$ref": "#/$defs/CauseValue",
          "description": "Value before the change point."
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CauseKind"
        }
      },
      "required": [
        "after",
        "before",
        "description",
        "kind"
      ],
      "type": "object"
    },
    "CauseKind": {
      "description": "`CandidateCause.kind` (M3's names).",
      "enum": [
        "time_control_mix",
        "new_opening",
        "session_length",
        "rating_level",
        "protocol_version"
      ],
      "type": "string"
    },
    "CauseValue": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "`CandidateCause.before`/`after`: a short text or a number."
    },
    "ChangeExample": {
      "additionalProperties": false,
      "description": "`TimelineChange.examples[]`: an exemplar plus which side of the change point it is from.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoveRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's preferred move, or null when `played` was already best."
        },
        "bestPv": {
          "description": "Engine line starting with the best move from `fen` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evalAfter": {
          "$ref": "#/$defs/Score"
        },
        "evalBefore": {
          "$ref": "#/$defs/Score"
        },
        "fen": {
          "description": "Position BEFORE `played`, standard FEN.",
          "maxLength": 100,
          "type": "string"
        },
        "gameId": {
          "description": "Platform game id (R-7).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "played": {
          "$ref": "#/$defs/MoveRef"
        },
        "playedAt": {
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "ply": {
          "description": "1-based half-move number of the position's side to move: odd = White, even = Black.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "refutationPv": {
          "description": "Engine line starting from the position AFTER `played` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/ExampleSide"
        },
        "tags": {
          "description": "Short classifier tags such as `hanging_piece`.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "winAfter": {
          "description": "The mover's win percentage after the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "winBefore": {
          "description": "The mover's win percentage before the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "best",
        "bestPv",
        "evalAfter",
        "evalBefore",
        "fen",
        "gameId",
        "played",
        "playedAt",
        "ply",
        "refutationPv",
        "side",
        "tags",
        "winAfter",
        "winBefore"
      ],
      "type": "object"
    },
    "DeltaVerdict": {
      "enum": [
        "improved",
        "worse",
        "no_clear_change"
      ],
      "type": "string"
    },
    "EfficacyVerdict": {
      "description": "\"Is it working?\" (ADR 0090 §8): a change is claimed only when both sides have 30 chances\nand the 80% ranges separate.",
      "enum": [
        "too_early",
        "lower",
        "higher",
        "no_clear_change"
      ],
      "type": "string"
    },
    "ExampleSide": {
      "description": "`TimelineChange.examples[].side`.",
      "enum": [
        "before",
        "after"
      ],
      "type": "string"
    },
    "ExemplarPosition": {
      "additionalProperties": false,
      "description": "A concrete position from one of the player's games, cited as evidence.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoveRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's preferred move, or null when `played` was already best."
        },
        "bestPv": {
          "description": "Engine line starting with the best move from `fen` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evalAfter": {
          "$ref": "#/$defs/Score"
        },
        "evalBefore": {
          "$ref": "#/$defs/Score"
        },
        "fen": {
          "description": "Position BEFORE `played`, standard FEN.",
          "maxLength": 100,
          "type": "string"
        },
        "gameId": {
          "description": "Platform game id (R-7).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "played": {
          "$ref": "#/$defs/MoveRef"
        },
        "playedAt": {
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "ply": {
          "description": "1-based half-move number of the position's side to move: odd = White, even = Black.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "refutationPv": {
          "description": "Engine line starting from the position AFTER `played` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "tags": {
          "description": "Short classifier tags such as `hanging_piece`.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "winAfter": {
          "description": "The mover's win percentage after the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "winBefore": {
          "description": "The mover's win percentage before the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "best",
        "bestPv",
        "evalAfter",
        "evalBefore",
        "fen",
        "gameId",
        "played",
        "playedAt",
        "ply",
        "refutationPv",
        "tags",
        "winAfter",
        "winBefore"
      ],
      "type": "object"
    },
    "FocusOutcome": {
      "description": "How a focus that has reached its N games ended (ADR 0091 §5).",
      "enum": [
        "met",
        "not_met",
        "inconclusive"
      ],
      "type": "string"
    },
    "FocusStatus": {
      "description": "Where a running focus stands (ADR 0091 §4): below 10 chances it is too early to tell.",
      "enum": [
        "on_track",
        "not_yet",
        "too_early"
      ],
      "type": "string"
    },
    "FocusUpdate": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "pImp": {
          "description": "Probability of improvement; drives the likelihood words of outcome items.",
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/WeaknessState"
        },
        "weaknessId": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "pImp",
        "state",
        "weaknessId"
      ],
      "type": "object"
    },
    "MetricDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/MetricPoint"
        },
        "area": {
          "$ref": "#/$defs/AreaId"
        },
        "before": {
          "$ref": "#/$defs/MetricPoint"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/DeltaVerdict"
        }
      },
      "required": [
        "after",
        "area",
        "before",
        "key",
        "label",
        "verdict"
      ],
      "type": "object"
    },
    "MetricPoint": {
      "additionalProperties": false,
      "description": "A metric estimate at one end of the week.",
      "properties": {
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "description": "Credible interval ends; `null` when there is no interval (as `Metric.low`/`high`).",
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "high",
        "low",
        "n",
        "value"
      ],
      "type": "object"
    },
    "MoveRef": {
      "additionalProperties": false,
      "description": "A move as SAN (display) and UCI (machine, e.g. `e2e4` or `e7e8q`).",
      "properties": {
        "san": {
          "maxLength": 12,
          "minLength": 1,
          "type": "string"
        },
        "uci": {
          "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
          "type": "string"
        }
      },
      "required": [
        "san",
        "uci"
      ],
      "type": "object"
    },
    "PatternEfficacy": {
      "additionalProperties": false,
      "description": "Drilled against held back: how often the motifs of drilled positions were found in later\ngames, against motifs only held-out positions have. `events` counts the times found.",
      "properties": {
        "drilled": {
          "$ref": "#/$defs/PlanRate"
        },
        "heldOut": {
          "$ref": "#/$defs/PlanRate"
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/EfficacyVerdict"
        }
      },
      "required": [
        "drilled",
        "heldOut",
        "since",
        "verdict"
      ],
      "type": "object"
    },
    "PlanContext": {
      "additionalProperties": false,
      "description": "What one user is working on (ADR 0094): their focus, their training and whether it is\nworking, for one of their accounts and a time class. Never shared across users.",
      "properties": {
        "asOf": {
          "description": "The UTC day the context was built on.",
          "type": "string"
        },
        "focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanFocus"
            },
            {
              "type": "null"
            }
          ]
        },
        "isItWorking": {
          "items": {
            "$ref": "#/$defs/SourceEfficacy"
          },
          "type": "array"
        },
        "patterns": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatternEfficacy"
            },
            {
              "type": "null"
            }
          ]
        },
        "training": {
          "$ref": "#/$defs/PlanTraining"
        }
      },
      "required": [
        "asOf",
        "focus",
        "isItWorking",
        "patterns",
        "training"
      ],
      "type": "object"
    },
    "PlanFocus": {
      "additionalProperties": false,
      "description": "The user's running focus on this account and time class (ADR 0091), with its live progress.",
      "properties": {
        "baselineChances": {
          "minimum": 0,
          "type": "integer"
        },
        "baselineEvents": {
          "minimum": 0,
          "type": "integer"
        },
        "baselineRate": {
          "description": "What the focus started from: the estimate's rate and its unweighted counts.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "gamesN": {
          "description": "N: the focus's length in analysed games.",
          "minimum": 0,
          "type": "integer"
        },
        "gamesPlayed": {
          "description": "Analysed games played since the focus started (at most N).",
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "description": "The weakness's plain name.",
          "type": "string"
        },
        "moreChances": {
          "description": "Chances still needed before a verdict (only while `too_early`).",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusOutcome"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set once the focus has its N games."
        },
        "progress": {
          "$ref": "#/$defs/PlanRate",
          "description": "The weakness's events and chances in those games, the rate and its 80% range."
        },
        "seriesKey": {
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/PlanSide"
        },
        "startedOn": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FocusStatus"
        },
        "targetRate": {
          "description": "The goal: at most this share of chances over the focus's games.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "baselineChances",
        "baselineEvents",
        "baselineRate",
        "gamesN",
        "gamesPlayed",
        "label",
        "moreChances",
        "outcome",
        "progress",
        "seriesKey",
        "side",
        "startedOn",
        "status",
        "targetRate"
      ],
      "type": "object"
    },
    "PlanRate": {
      "additionalProperties": false,
      "description": "A rate per chance with its n and its 80% Wilson range (null without a chance).",
      "properties": {
        "chances": {
          "minimum": 0,
          "type": "integer"
        },
        "events": {
          "minimum": 0,
          "type": "integer"
        },
        "high": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "rate": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "chances",
        "events",
        "high",
        "low",
        "rate"
      ],
      "type": "object"
    },
    "PlanSide": {
      "description": "The colour a focus counts (ADR 0082): `both` counts every game.",
      "enum": [
        "both",
        "white",
        "black"
      ],
      "type": "string"
    },
    "PlanTraining": {
      "additionalProperties": false,
      "properties": {
        "activeItems": {
          "description": "Positions waiting in the trainer (not held out, not retired).",
          "minimum": 0,
          "type": "integer"
        },
        "lastMonth": {
          "$ref": "#/$defs/TrainingWindow"
        },
        "lastWeek": {
          "$ref": "#/$defs/TrainingWindow"
        }
      },
      "required": [
        "activeItems",
        "lastMonth",
        "lastWeek"
      ],
      "type": "object"
    },
    "Score": {
      "description": "An engine evaluation from WHITE's point of view: `{\"cp\": n}` (centipawns, positive = White\nbetter) or `{\"mate\": n}` (moves to mate, positive = White mates).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cp": {
              "maximum": 100000,
              "minimum": -100000,
              "type": "integer"
            }
          },
          "required": [
            "cp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mate": {
              "maximum": 500,
              "minimum": -500,
              "type": "integer"
            }
          },
          "required": [
            "mate"
          ],
          "type": "object"
        }
      ]
    },
    "SourceEfficacy": {
      "additionalProperties": false,
      "description": "\"Is it working?\" for one source: the weakness rate per chance in games before its first\ndrill and from it on.",
      "properties": {
        "after": {
          "$ref": "#/$defs/PlanRate"
        },
        "before": {
          "$ref": "#/$defs/PlanRate"
        },
        "drilled": {
          "description": "Items of the source drilled at least once.",
          "minimum": 0,
          "type": "integer"
        },
        "firstDrill": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/EfficacyVerdict"
        }
      },
      "required": [
        "after",
        "before",
        "drilled",
        "firstDrill",
        "label",
        "source",
        "verdict"
      ],
      "type": "object"
    },
    "SourceTraining": {
      "additionalProperties": false,
      "description": "One trainer source's attempts in a window.",
      "properties": {
        "attempts": {
          "minimum": 0,
          "type": "integer"
        },
        "firstTryRate": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "right": {
          "description": "Attempts answered right (each is the item's first try that day, ADR 0090 §5).",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "attempts",
        "firstTryRate",
        "label",
        "right",
        "source"
      ],
      "type": "object"
    },
    "TimeClass": {
      "description": "`CoachingInput.timeClass`.",
      "enum": [
        "bullet",
        "blitz",
        "rapid",
        "classical",
        "daily"
      ],
      "type": "string"
    },
    "TimelineChange": {
      "additionalProperties": false,
      "properties": {
        "candidateCauses": {
          "items": {
            "$ref": "#/$defs/CandidateCause"
          },
          "maxItems": 6,
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/ChangeExample"
          },
          "maxItems": 6,
          "type": "array"
        },
        "fromState": {
          "$ref": "#/$defs/WeaknessState"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "onsetDate": {
          "format": "date",
