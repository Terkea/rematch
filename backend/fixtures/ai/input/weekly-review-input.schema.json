{
  "$defs": {
    "Adherence": {
      "additionalProperties": false,
      "description": "Practice done against plan this week; `null` in the input when nothing was planned.",
      "properties": {
        "minutesDone": {
          "minimum": 0,
          "type": "integer"
        },
        "minutesPlanned": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "minutesDone",
        "minutesPlanned"
      ],
      "type": "object"
    },
    "AreaId": {
      "description": "One of the seven coaching areas (zod `AreaId`).",
      "enum": [
        "openings",
        "middlegame",
        "endgame",
        "tactics",
        "calculation",
        "time",
        "mindset"
      ],
      "type": "string"
    },
    "BandId": {
      "description": "Rating band on the Lichess-equivalent scale (zod `BandId`).",
      "enum": [
        "B0",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5"
      ],
      "type": "string"
    },
    "Basis": {
      "additionalProperties": false,
      "properties": {
        "analysedGames": {
          "description": "Games with engine analysis, the evidence window size.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "backfillComplete": {
          "description": "Whether the full history import finished.",
          "type": "boolean"
        },
        "importedGames": {
          "description": "Games imported from the platform (>= `analysedGames`).",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "windowEnd": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "windowStart": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        }
      },
      "required": [
        "analysedGames",
        "backfillComplete",
        "importedGames",
        "windowEnd",
        "windowStart"
      ],
      "type": "object"
    },
    "CandidateCause": {
      "additionalProperties": false,
      "description": "A correlated possible cause of a change, never proven.",
      "properties": {
        "after": {
          "$ref": "#/$defs/CauseValue",
          "description": "Value after the change point."
        },
        "before": {
          "$ref": "#/$defs/CauseValue",
          "description": "Value before the change point."
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CauseKind"
        }
      },
      "required": [
        "after",
        "before",
        "description",
        "kind"
      ],
      "type": "object"
    },
    "CauseKind": {
      "description": "`CandidateCause.kind` (M3's names).",
      "enum": [
        "time_control_mix",
        "new_opening",
        "session_length",
        "rating_level",
        "protocol_version"
      ],
      "type": "string"
    },
    "CauseValue": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "`CandidateCause.before`/`after`: a short text or a number."
    },
    "ChangeExample": {
      "additionalProperties": false,
      "description": "`TimelineChange.examples[]`: an exemplar plus which side of the change point it is from.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoveRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's preferred move, or null when `played` was already best."
        },
        "bestPv": {
          "description": "Engine line starting with the best move from `fen` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evalAfter": {
          "$ref": "#/$defs/Score"
        },
        "evalBefore": {
          "$ref": "#/$defs/Score"
        },
        "fen": {
          "description": "Position BEFORE `played`, standard FEN.",
          "maxLength": 100,
          "type": "string"
        },
        "gameId": {
          "description": "Platform game id (R-7).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "played": {
          "$ref": "#/$defs/MoveRef"
        },
        "playedAt": {
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "ply": {
          "description": "1-based half-move number of the position's side to move: odd = White, even = Black.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "refutationPv": {
          "description": "Engine line starting from the position AFTER `played` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/ExampleSide"
        },
        "tags": {
          "description": "Short classifier tags such as `hanging_piece`.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "winAfter": {
          "description": "The mover's win percentage after the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "winBefore": {
          "description": "The mover's win percentage before the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "best",
        "bestPv",
        "evalAfter",
        "evalBefore",
        "fen",
        "gameId",
        "played",
        "playedAt",
        "ply",
        "refutationPv",
        "side",
        "tags",
        "winAfter",
        "winBefore"
      ],
      "type": "object"
    },
    "DeltaVerdict": {
      "enum": [
        "improved",
        "worse",
        "no_clear_change"
      ],
      "type": "string"
    },
    "ExampleSide": {
      "description": "`TimelineChange.examples[].side`.",
      "enum": [
        "before",
        "after"
      ],
      "type": "string"
    },
    "ExemplarPosition": {
      "additionalProperties": false,
      "description": "A concrete position from one of the player's games, cited as evidence.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoveRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's preferred move, or null when `played` was already best."
        },
        "bestPv": {
          "description": "Engine line starting with the best move from `fen` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evalAfter": {
          "$ref": "#/$defs/Score"
        },
        "evalBefore": {
          "$ref": "#/$defs/Score"
        },
        "fen": {
          "description": "Position BEFORE `played`, standard FEN.",
          "maxLength": 100,
          "type": "string"
        },
        "gameId": {
          "description": "Platform game id (R-7).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "played": {
          "$ref": "#/$defs/MoveRef"
        },
        "playedAt": {
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "ply": {
          "description": "1-based half-move number of the position's side to move: odd = White, even = Black.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "refutationPv": {
          "description": "Engine line starting from the position AFTER `played` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "tags": {
          "description": "Short classifier tags such as `hanging_piece`.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "winAfter": {
          "description": "The mover's win percentage after the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "winBefore": {
          "description": "The mover's win percentage before the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "best",
        "bestPv",
        "evalAfter",
        "evalBefore",
        "fen",
        "gameId",
        "played",
        "playedAt",
        "ply",
        "refutationPv",
        "tags",
        "winAfter",
        "winBefore"
      ],
      "type": "object"
    },
    "FocusUpdate": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "pImp": {
          "description": "Probability of improvement; drives the likelihood words of outcome items.",
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/WeaknessState"
        },
        "weaknessId": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "pImp",
        "state",
        "weaknessId"
      ],
      "type": "object"
    },
    "MetricDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/MetricPoint"
        },
        "area": {
          "$ref": "#/$defs/AreaId"
        },
        "before": {
          "$ref": "#/$defs/MetricPoint"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/DeltaVerdict"
        }
      },
      "required": [
        "after",
        "area",
        "before",
        "key",
        "label",
        "verdict"
      ],
      "type": "object"
    },
    "MetricPoint": {
      "additionalProperties": false,
      "description": "A metric estimate at one end of the week.",
      "properties": {
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "description": "Credible interval ends; `null` when there is no interval (as `Metric.low`/`high`).",
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "high",
        "low",
        "n",
        "value"
      ],
      "type": "object"
    },
    "MoveRef": {
      "additionalProperties": false,
      "description": "A move as SAN (display) and UCI (machine, e.g. `e2e4` or `e7e8q`).",
      "properties": {
        "san": {
          "maxLength": 12,
          "minLength": 1,
          "type": "string"
        },
        "uci": {
          "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
          "type": "string"
        }
      },
      "required": [
        "san",
        "uci"
      ],
      "type": "object"
    },
    "Score": {
      "description": "An engine evaluation from WHITE's point of view: `{\"cp\": n}` (centipawns, positive = White\nbetter) or `{\"mate\": n}` (moves to mate, positive = White mates).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cp": {
              "maximum": 100000,
              "minimum": -100000,
              "type": "integer"
            }
          },
          "required": [
            "cp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mate": {
              "maximum": 500,
              "minimum": -500,
              "type": "integer"
            }
          },
          "required": [
            "mate"
          ],
          "type": "object"
        }
      ]
    },
    "TimeClass": {
      "description": "`CoachingInput.timeClass`.",
      "enum": [
        "bullet",
        "blitz",
        "rapid",
        "classical",
        "daily"
      ],
      "type": "string"
    },
    "TimelineChange": {
      "additionalProperties": false,
      "properties": {
        "candidateCauses": {
          "items": {
            "$ref": "#/$defs/CandidateCause"
          },
          "maxItems": 6,
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/ChangeExample"
          },
          "maxItems": 6,
          "type": "array"
        },
        "fromState": {
          "$ref": "#/$defs/WeaknessState"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "onsetDate": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "onsetFrom": {
          "description": "Uncertainty window for the onset: `onsetFrom <= onsetDate <= onsetTo`.",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "onsetGameId": {
          "description": "Game at which the change is placed.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "onsetTo": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "posteriorProb": {
          "description": "Posterior probability that a change happened, 0..1.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "rateAfter": {
          "description": "Event rate (0..1) after the change.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "rateBefore": {
          "description": "Event rate (0..1) before the change.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "seriesKey": {
          "description": "Key of the time series the change was detected on.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "toState": {
          "$ref": "#/$defs/WeaknessState"
        },
        "weaknessId": {
          "maxLength": 5,
          "pattern": "^W(1[0-2]|[1-9])[a-d]?$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "candidateCauses",
        "examples",
        "fromState",
        "label",
        "onsetDate",
        "onsetFrom",
        "onsetGameId",
        "onsetTo",
        "posteriorProb",
        "rateAfter",
        "rateBefore",
        "seriesKey",
        "toState",
        "weaknessId"
      ],
      "type": "object"
    },
    "WeaknessState": {
      "description": "Weakness timeline state (zod `WeaknessState`).",
      "enum": [
        "not_an_issue",
        "emerging",
        "active",
        "improving",
        "resolved",
        "relapsed"
      ],
      "type": "string"
    },
    "WeeklyInputVersion": {
      "description": "`inputVersion`: the literal `\"weekly-input-v1\"`.",
      "enum": [
        "weekly-input-v1"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "TS `WeeklyReviewInput` (plan B4), field for field. `exemplars` has at most 2 entries\n([`WeeklyReviewInput::check_bounds`]).",
  "properties": {
    "adherence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Adherence"
        },
        {
          "type": "null"
        }
      ]
    },
    "band": {
      "$ref": "#/$defs/BandId"
    },
    "basis": {
      "$ref": "#/$defs/Basis"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/TimelineChange"
      },
      "type": "array"
    },
    "exemplars": {
      "items": {
        "$ref": "#/$defs/ExemplarPosition"
      },
      "maxItems": 2,
      "type": "array"
    },
    "focusUpdates": {
      "items": {
        "$ref": "#/$defs/FocusUpdate"
      },
      "type": "array"
    },
    "gamesThisWeek": {
      "minimum": 0,
      "type": "integer"
    },
    "inputVersion": {
      "$ref": "#/$defs/WeeklyInputVersion"
    },
    "metricDeltas": {
      "items": {
        "$ref": "#/$defs/MetricDelta"
      },
      "type": "array"
    },
    "timeClass": {
      "$ref": "#/$defs/TimeClass"
    },
    "weekEnd": {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
    },
    "weekStart": {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
    }
  },
  "required": [
    "adherence",
    "band",
    "basis",
    "changes",
    "exemplars",
    "focusUpdates",
    "gamesThisWeek",
    "inputVersion",
    "metricDeltas",
    "timeClass",
    "weekEnd",
    "weekStart"
  ],
  "title": "WeeklyReviewInput",
  "type": "object"
}
