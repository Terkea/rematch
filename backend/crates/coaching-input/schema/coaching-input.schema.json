{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "description": "`OpeningVerdict.alternatives[]`.",
      "properties": {
        "bandScore": {
          "description": "Band-average score with this alternative, 0..1.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "games": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "movesSan": {
          "items": {
            "maxLength": 12,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "type": "array"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "bandScore",
        "games",
        "movesSan",
        "name"
      ],
      "type": "object"
    },
    "AreaId": {
      "description": "One of the seven coaching areas (zod `AreaId`).",
      "enum": [
        "openings",
        "middlegame",
        "endgame",
        "tactics",
        "calculation",
        "time",
        "mindset"
      ],
      "type": "string"
    },
    "AreaScore": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/AreaId"
        },
        "n": {
          "description": "Observations behind the score.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "needMore": {
          "description": "More observations needed to reach sufficiency; null when sufficient.",
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "score": {
          "description": "0..100 (higher = stronger); null when there is not enough data.",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "sufficient": {
          "type": "boolean"
        }
      },
      "required": [
        "area",
        "n",
        "needMore",
        "score",
        "sufficient"
      ],
      "type": "object"
    },
    "BandId": {
      "description": "Rating band on the Lichess-equivalent scale (zod `BandId`).",
      "enum": [
        "B0",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5"
      ],
      "type": "string"
    },
    "Basis": {
      "additionalProperties": false,
      "properties": {
        "analysedGames": {
          "description": "Games with engine analysis, the evidence window size.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "backfillComplete": {
          "description": "Whether the full history import finished.",
          "type": "boolean"
        },
        "importedGames": {
          "description": "Games imported from the platform (>= `analysedGames`).",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "windowEnd": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "windowStart": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        }
      },
      "required": [
        "analysedGames",
        "backfillComplete",
        "importedGames",
        "windowEnd",
        "windowStart"
      ],
      "type": "object"
    },
    "Benchmark": {
      "additionalProperties": false,
      "description": "v2: the group every `bandMedian`, `bandPercentile` and `peerRate` compares with (the\naccount's stored benchmark, ADR 0080). With `peers` it is the opponents the player has faced\non the platform, rated `ratingLow`..`ratingHigh` on its own scale; the four numbers are then\nall present. Measured only in their games against the player, so a rough guide.",
      "properties": {
        "games": {
          "description": "Their games against the player in the window.",
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "players": {
          "description": "Distinct opponents in the window.",
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ratingHigh": {
          "maximum": 4000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ratingLow": {
          "maximum": 4000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/BenchmarkSource"
        }
      },
      "required": [
        "games",
        "players",
        "ratingHigh",
        "ratingLow",
        "source"
      ],
      "type": "object"
    },
    "BenchmarkSource": {
      "description": "v2 `benchmark.source` (ADR 0080): the players a comparison is made with.",
      "enum": [
        "peers",
        "lichess_bands"
      ],
      "type": "string"
    },
    "ByColor": {
      "additionalProperties": false,
      "description": "v2: the colour split (ADR 0082, 0084).",
      "properties": {
        "black": {
          "$ref": "#/$defs/ColorSummary"
        },
        "white": {
          "$ref": "#/$defs/ColorSummary"
        }
      },
      "required": [
        "black",
        "white"
      ],
      "type": "object"
    },
    "CandidateCause": {
      "additionalProperties": false,
      "description": "A correlated possible cause of a change, never proven.",
      "properties": {
        "after": {
          "$ref": "#/$defs/CauseValue",
          "description": "Value after the change point."
        },
        "before": {
          "$ref": "#/$defs/CauseValue",
          "description": "Value before the change point."
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CauseKind"
        }
      },
      "required": [
        "after",
        "before",
        "description",
        "kind"
      ],
      "type": "object"
    },
    "CauseKind": {
      "description": "`CandidateCause.kind` (M3's names).",
      "enum": [
        "time_control_mix",
        "new_opening",
        "session_length",
        "rating_level",
        "protocol_version"
      ],
      "type": "string"
    },
    "CauseValue": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "`CandidateCause.before`/`after`: a short text or a number."
    },
    "ChangeExample": {
      "additionalProperties": false,
      "description": "`TimelineChange.examples[]`: an exemplar plus which side of the change point it is from.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoveRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's preferred move, or null when `played` was already best."
        },
        "bestPv": {
          "description": "Engine line starting with the best move from `fen` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evalAfter": {
          "$ref": "#/$defs/Score"
        },
        "evalBefore": {
          "$ref": "#/$defs/Score"
        },
        "fen": {
          "description": "Position BEFORE `played`, standard FEN.",
          "maxLength": 100,
          "type": "string"
        },
        "gameId": {
          "description": "Platform game id (R-7).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "played": {
          "$ref": "#/$defs/MoveRef"
        },
        "playedAt": {
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "ply": {
          "description": "1-based half-move number of the position's side to move: odd = White, even = Black.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "refutationPv": {
          "description": "Engine line starting from the position AFTER `played` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/ExampleSide"
        },
        "tags": {
          "description": "Short classifier tags such as `hanging_piece`.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "winAfter": {
          "description": "The mover's win percentage after the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "winBefore": {
          "description": "The mover's win percentage before the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "best",
        "bestPv",
        "evalAfter",
        "evalBefore",
        "fen",
        "gameId",
        "played",
        "playedAt",
        "ply",
        "refutationPv",
        "side",
        "tags",
        "winAfter",
        "winBefore"
      ],
      "type": "object"
    },
    "ChangeVerdict": {
      "description": "v3: a then-against-now verdict, from the player's point of view (ADR 0083 §6).",
      "enum": [
        "better",
        "worse",
        "no_clear_change",
        "not_enough_games"
      ],
      "type": "string"
    },
    "ColorMetric": {
      "additionalProperties": false,
      "description": "v2: one number of a colour, with its 80% interval. Below its minimum evidence it is stated\nas insufficient: `value`, `low` and `high` are null (never 0) and `needMore` says how many\nmore observations it needs.",
      "properties": {
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "description": "Observations behind it (games).",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "needMore": {
          "description": "More observations needed to become sufficient; null when sufficient.",
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sufficient": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/MetricUnit"
        },
        "value": {
          "description": "In `unit`; null when not sufficient.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "high",
        "low",
        "n",
        "needMore",
        "sufficient",
        "unit",
        "value"
      ],
      "type": "object"
    },
    "ColorSummary": {
      "additionalProperties": false,
      "description": "v2: the player's games with one colour.",
      "properties": {
        "accuracy": {
          "$ref": "#/$defs/ColorMetric",
          "description": "Mean game accuracy, 0..100 (`pct`)."
        },
        "blundersPerGame": {
          "$ref": "#/$defs/ColorMetric",
          "description": "Mean blunders per game (`per_game`)."
        },
        "draws": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "games": {
          "description": "Analysed games with this colour in the window: the colour's most recent, at most 50\n(the KPI `last50` window). `wins + draws + losses = games`.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "losses": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "needMore": {
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "score": {
          "$ref": "#/$defs/ColorMetric",
          "description": "Points per game, 0..1 (`rate`): a draw is half a point."
        },
        "sufficient": {
          "description": "`games >= MIN_COLOR_GAMES`; below it nothing about the colour is stated.",
          "type": "boolean"
        },
        "weaknesses": {
          "description": "The colour's top weakness rates (claimable against its own peers, else uncompared), at\nmost `LIMITS.colorWeaknesses`; empty below 30 games of the colour in the 6-month window.",
          "items": {
            "$ref": "#/$defs/ColorWeakness"
          },
          "maxItems": 5,
          "type": "array"
        },
        "wins": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "accuracy",
        "blundersPerGame",
        "draws",
        "games",
        "losses",
        "needMore",
        "score",
        "sufficient",
        "weaknesses",
        "wins"
      ],
      "type": "object"
    },
    "ColorWeakness": {
      "additionalProperties": false,
      "description": "v2: a weakness rate measured over one colour's games only (the stored `side` estimate rows,\nADR 0082), with that colour's own peer comparison when one exists (never the both one).",
      "properties": {
        "area": {
          "$ref": "#/$defs/AreaId"
        },
        "events": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "high": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "id": {
          "maxLength": 5,
          "pattern": "^W(1[0-2]|[1-9])[a-d]?$",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "low": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "opportunities": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "peerPercentile": {
          "description": "Where `rate` sits against `peerRate`'s spread, 0..100 (higher = fewer errors).",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "peerPlayers": {
          "description": "Opponents behind `peerRate`.",
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "peerRate": {
          "description": "This colour's peers' pooled rate; null when the colour has no comparison of its own.",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "rate": {
          "description": "Posterior event rate over this colour's games, events per opportunity.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "seriesKey": {
          "description": "The weakness series key (`W3.shallow`); unique within the colour.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "variant": {
          "maxLength": 40,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "area",
        "events",
        "high",
        "id",
        "label",
        "low",
        "opportunities",
        "peerPercentile",
        "peerPlayers",
        "peerRate",
        "rate",
        "seriesKey",
        "variant"
      ],
      "type": "object"
    },
    "ExampleSide": {
      "description": "`TimelineChange.examples[].side`.",
      "enum": [
        "before",
        "after"
      ],
      "type": "string"
    },
    "ExemplarPosition": {
      "additionalProperties": false,
      "description": "A concrete position from one of the player's games, cited as evidence.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoveRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's preferred move, or null when `played` was already best."
        },
        "bestPv": {
          "description": "Engine line starting with the best move from `fen` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evalAfter": {
          "$ref": "#/$defs/Score"
        },
        "evalBefore": {
          "$ref": "#/$defs/Score"
        },
        "fen": {
          "description": "Position BEFORE `played`, standard FEN.",
          "maxLength": 100,
          "type": "string"
        },
        "gameId": {
          "description": "Platform game id (R-7).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "played": {
          "$ref": "#/$defs/MoveRef"
        },
        "playedAt": {
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "ply": {
          "description": "1-based half-move number of the position's side to move: odd = White, even = Black.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "refutationPv": {
          "description": "Engine line starting from the position AFTER `played` (UCI).",
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "tags": {
          "description": "Short classifier tags such as `hanging_piece`.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "type": "array"
        },
        "winAfter": {
          "description": "The mover's win percentage after the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "winBefore": {
          "description": "The mover's win percentage before the move, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "best",
        "bestPv",
        "evalAfter",
        "evalBefore",
        "fen",
        "gameId",
        "played",
        "playedAt",
        "ply",
        "refutationPv",
        "tags",
        "winAfter",
        "winBefore"
      ],
      "type": "object"
    },
    "LineSide": {
      "description": "`chosen`: the player plays the line; `faced`: the opponent plays it against the player.",
      "enum": [
        "chosen",
        "faced"
      ],
      "type": "string"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/AreaId"
        },
        "bandMedian": {
          "description": "Median of the player's rating band for this metric, in `unit`.",
          "type": [
            "number",
            "null"
          ]
        },
        "bandPercentile": {
          "description": "Percentile within the band, 0..100.",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "high": {
          "description": "Upper end of the credible interval, in `unit`.",
          "type": [
            "number",
            "null"
          ]
        },
        "key": {
          "description": "Stable metric key.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "low": {
          "description": "Lower end of the credible interval, in `unit`.",
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "description": "Number of observations behind the estimate.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "needMore": {
          "description": "More observations needed to become sufficient; null when sufficient.",
          "maximum": 100000000,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sufficient": {
          "description": "True when `n` meets the minimum sample for this metric.",
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/MetricUnit"
        },
        "value": {
          "description": "Point estimate in `unit` (range checked by `validate`).",
          "type": "number"
        }
      },
      "required": [
        "area",
        "bandMedian",
        "bandPercentile",
        "high",
        "key",
        "label",
        "low",
        "n",
        "needMore",
        "sufficient",
        "unit",
        "value"
      ],
      "type": "object"
    },
    "MetricUnit": {
      "description": "What a metric's `value`, `low`, `high` and `bandMedian` measure: `rate` (events per\nopportunity, 0..1), `per_game` (a count per game, 0..1000), `pct` (0..100), `seconds`\n(0..100 000) or `elo` (a rating-point quantity, 0..4000).",
      "enum": [
        "rate",
        "per_game",
        "pct",
        "seconds",
        "elo"
      ],
      "type": "string"
    },
    "MonthRating": {
      "additionalProperties": false,
      "description": "v3: one calendar month (UTC) of the rating line.",
      "properties": {
        "games": {
          "description": "Rated games played in the month.",
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        "high": {
          "description": "The month's highest pre-game rating.",
          "maximum": 4000,
          "minimum": 0,
          "type": "integer"
        },
        "last": {
          "description": "The pre-game rating of the month's last game.",
          "maximum": 4000,
          "minimum": 0,
          "type": "integer"
        },
        "month": {
          "description": "`YYYY-MM`.",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        }
      },
