  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What R2 produces for the AI coach (R3) and the web: the M3 `CoachingInput`.",
  "properties": {
    "accountId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "areaScores": {
      "description": "Each `AreaId` exactly once.",
      "items": {
        "$ref": "#/$defs/AreaScore"
      },
      "maxItems": 7,
      "type": "array"
    },
    "band": {
      "$ref": "#/$defs/BandId"
    },
    "basis": {
      "$ref": "#/$defs/Basis"
    },
    "benchmark": {
      "anyOf": [
