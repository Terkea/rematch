# Rematch self-hosting settings for deploy/compose.yaml (ADR 0098). Copy to .env next to
# compose.yaml and fill in every "required" value. Never commit the filled-in file.
# Generate secrets with: openssl rand -hex 32

# Required. Letters and digits only: it goes into a postgres:// URL unescaped.
POSTGRES_PASSWORD=

# Required, 32+ characters. Signs sessions; changing it signs everyone out.
BETTER_AUTH_SECRET=
# Required. The address players open, e.g. https://rematch.example.org. Sign-in links use it.
BETTER_AUTH_URL=
# Extra origins allowed to call the auth API, comma-separated. Usually empty.
BETTER_AUTH_TRUSTED_ORIGINS=
# Required. Sign-in is by emailed link. smtp://user:password@smtp.example.org:587
SMTP_URL=
MAIL_FROM=Rematch <no-reply@rematch.example.org>

# Host port on 127.0.0.1 for the web app (default 3100). Expose it through a TLS reverse proxy.
WEB_PORT=3100
# The proxy's address(es) as CIDRs, so rate limits see the real client address (ADR-WEB-3).
# Empty: forwarding headers are ignored and every client shares one bucket.
TRUSTED_PROXIES=
IP_ADDRESS_HEADERS=x-forwarded-for

# Sign-up is invite-only unless INVITE_ONLY is exactly 0 (ADR 0041). Invited addresses,
# comma-separated; add yours before the first sign-in.
INVITE_ONLY=1
INVITE_ALLOWLIST=

# chess.com linking is on unless set to 0; Lichess sign-in and linking only when exactly 1.
CHESSCOM_ENABLED=1
LICHESS_ENABLED=0
# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker. Stockfish processes (and games analysed at once); empty: min(cores - 2, 8).
WORKER_POOL_SIZE=
# Minutes between syncs of each linked account's newest games; empty: 30.
SYNC_INTERVAL_MINUTES=
# Optional Lichess API token for higher rate limits.
LICHESS_TOKEN=
# Folder with the optional Syzygy 3-4-5 tables in <dir>/syzygy (984 MB). How to fetch them:
# "Syzygy tables" in docs/RELEASING.md.
REMATCH_DATA_DIR=./data

# AI coach (optional, ADR 0062). Without it, every number and report is still computed; only the
# written coaching is off. To turn it on, set all five values below, then
# `docker compose up -d` and, once, `docker compose run --rm ai-sidecar-role`.
# COMPOSE_PROFILES=ai
# AI_SIDECAR_URL=http://ai-sidecar:7310
# 32+ characters, shared by the worker and the sidecar.
AI_SIDECAR_TOKEN=
# An Anthropic API key. A personal Claude login or subscription token is refused in production.
ANTHROPIC_API_KEY=
# 16+ characters, letters and digits only; the sidecar's own database login.
AI_SIDECAR_DB_PASSWORD=
# Monthly AI budgets in micro-USD (ADR 0061); empty keeps the defaults, the global cap is off.
AI_BUDGET_FREE_MICRO_USD=
AI_BUDGET_PRO_MICRO_USD=
AI_GLOBAL_MONTHLY_BUDGET_MICRO_USD=
# Every account's AI plan: beta, free or pro (empty: beta).
AI_DEFAULT_PLAN=
AI_BETA_CHAT_WEEKLY=
AI_BETA_MANUAL_REPORTS_PER_DAY=
