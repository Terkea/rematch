# Copy to .env (never committed). Compose injects the in-container values itself;
# these are for running tools from the host.
# Host ports (Postgres 55432, Redis 56379; see docs/decisions/0023) are opt-in: the base
# docker-compose.yml publishes none, so parallel `-p <name>` projects never clash. This line enables
# them for the main stack. COMPOSE_PATH_SEPARATOR is explicit because Compose defaults to `;` on Windows.
# Parallel/CI runs: COMPOSE_FILE=docker-compose.yml docker compose -p <name> ... (no host ports).
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml
COMPOSE_PATH_SEPARATOR=:
DATABASE_URL=postgres://postgres:postgres@localhost:55432/chess
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:55432/chess_test
WORKER_DATABASE_URL_TEST=postgres://postgres:postgres@localhost:55432/chess_worker_test
REDIS_URL=redis://localhost:56379
STOCKFISH_PATH=/usr/local/bin/stockfish
# Required by the worker (sent in the User-Agent of every platform request). No default there;
# rust-dev falls back to this placeholder. Never a real personal address.
CONTACT_EMAIL=dev@example.invalid
# Optional Lichess API token.
LICHESS_TOKEN=
# Rust worker (rust-worker service): Stockfish processes, which is also how many games are analysed
# at once. 8 suits a desktop and leaves room for everything else during a backfill. Empty means
# min(cores - 2, 8).
WORKER_POOL_SIZE=8

# Web app (apps/web). Compose injects its own in-container values; these are for host-side tools.
# Create the web test database on an existing volume with:
#   docker compose exec postgres psql -U postgres -c "CREATE DATABASE chess_web_test"
WEB_DATABASE_URL_TEST=postgres://postgres:postgres@localhost:55432/chess_web_test
# Required, 32+ characters. Compose uses a dev-only default when this is unset.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_TRUSTED_ORIGINS=
# Mail goes only to Mailpit (UI on http://127.0.0.1:48025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=chess-improver <no-reply@chess-improver.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LICHESS_CLIENT_ID=chess-improver
LICHESS_AUTHORIZE_BASE_URL=https://lichess.org
LICHESS_API_BASE_URL=https://lichess.org
CHESSCOM_API_BASE_URL=https://api.chess.com
# Flags (CHESSCOM_ENABLED, CHESSCOM_OAUTH_ENABLED, LAB_ENABLED) are on only when set to exactly "1".
CHESSCOM_ENABLED=
CHESSCOM_OAUTH_ENABLED=
LAB_ENABLED=
