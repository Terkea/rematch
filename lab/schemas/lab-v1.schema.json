        "primary_source": { "$ref": "#/$defs/SourceKey" },
        "held_out": { "type": "boolean" }
      }
    },
    "TrainerSourcesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "trainer_version", "sources", "candidates"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "trainer_version": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/SourceKey" } },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/TrainerSourced" } }
      }
    }
  }
}
