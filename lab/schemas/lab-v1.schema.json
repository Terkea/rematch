{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Terkea/rematch/lab/schemas/lab-v1.schema.json",
  "title": "Rematch lab bridge, lab-v1",
  "description": "The JSON of `cli lab analyse|profile|rank|tag-motifs|positions|evaluate|judge|observe` (ADR 0106). Validate one message with {\"$ref\": \"#/$defs/<Message>\"} next to these $defs. The envelope and the lab's own objects are snake_case; the algorithm's own types (WeaknessEstimate, BandReferenceStat, RankedWeakness) keep their camelCase serialisation.",
  "$defs": {
    "SchemaVersion": { "const": "lab-v1" },
    "AlgorithmId": {
      "description": "algo-<major>.<minor>.<patch>+<12 hex>, the manifest id (ADRs 0104 and 0105).",
      "type": "string",
      "pattern": "^algo-[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9a-f]{12}$"
    },
    "Time": { "type": "string", "format": "date-time" },
    "Band": { "enum": ["B0", "B1", "B2", "B3", "B4", "B5"] },
    "BinomialKey": {
      "enum": [
        "W1",
        "W2",
        "W3.shallow",
        "W3.deep",
        "W4.missed",
        "W4.allowed",
        "W5",
        "W6",
        "W7.traps",
        "W7.prep",
        "W8.basics",
        "W8.advanced",
        "W9a",
        "W9b",
        "W9c",
        "W10",
        "W11"
      ]
    },
    "WeaknessState": {
      "enum": ["not_an_issue", "emerging", "active", "improving", "resolved", "relapsed"]
    },
    "Count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "LabPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["played_at", "events", "opportunities"],
      "properties": {
        "played_at": { "$ref": "#/$defs/Time" },
        "events": { "$ref": "#/$defs/Count" },
        "opportunities": { "$ref": "#/$defs/Count" }
      }
    },
    "BandReferenceStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "median",
        "p25",
        "p40",
        "p75",
        "pooledRate",
        "eplPerEvent",
        "oppsPerGame",
        "oppSlopePer100",
        "nPlayers",
        "nGames",
        "lowSample"
      ],
      "properties": {
        "metric": { "type": "string" },
        "median": { "type": "number" },
        "p25": { "type": "number" },
        "p40": { "type": "number" },
        "p75": { "type": "number" },
        "pooledRate": { "type": ["number", "null"] },
        "eplPerEvent": { "type": ["number", "null"] },
        "oppsPerGame": { "type": ["number", "null"] },
        "oppSlopePer100": { "type": ["number", "null"] },
        "nPlayers": { "$ref": "#/$defs/Count" },
        "nGames": { "$ref": "#/$defs/Count" },
        "lowSample": { "type": "boolean" }
      }
    },
    "LabOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "#/$defs/WeaknessState" },
        "p_imp": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "Outcomes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/BinomialKey" },
      "additionalProperties": { "$ref": "#/$defs/LabOutcome" }
    },
    "PlayerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "now", "band", "games_in_window"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "now": { "$ref": "#/$defs/Time" },
        "band": { "$ref": "#/$defs/Band" },
        "games_in_window": { "$ref": "#/$defs/Count" },
        "series": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/BinomialKey" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/LabPoint" } }
        },
        "reference": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "propertyNames": { "type": "string", "pattern": "^[a-z_]+(:[A-Za-z0-9._]+)?$" },
              "additionalProperties": { "$ref": "#/$defs/BandReferenceStat" }
            }
          ]
        },
        "model_reference": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/BinomialKey" },
          "additionalProperties": { "$ref": "#/$defs/BandReferenceStat" }
        },
        "outcomes": { "$ref": "#/$defs/Outcomes" }
      }
    },
    "WeaknessEstimate": {
      "description": "profile_core::stats::priority::WeaknessEstimate, as serde writes it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "k",
        "n",
        "nUnweighted",
        "kUnweighted",
        "posterior",
        "bandMedian",
        "bandP40",
        "percentile",
        "confidence",
        "excess",
        "trainability",
        "priority",
        "precise",
        "minEvidenceMet",
        "reason",
        "credible",
        "modelBaseline",
        "invalidPoints"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/BinomialKey" },
        "k": { "type": "number", "minimum": 0 },
        "n": { "type": "number", "minimum": 0 },
        "nUnweighted": { "type": "number", "minimum": 0 },
        "kUnweighted": { "type": "number", "minimum": 0 },
        "posterior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alpha", "beta", "mean", "interval"],
          "properties": {
            "alpha": { "type": "number", "exclusiveMinimum": 0 },
            "beta": { "type": "number", "exclusiveMinimum": 0 },
            "mean": { "type": "number", "minimum": 0, "maximum": 1 },
            "interval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["low", "high"],
              "properties": {
                "low": { "type": "number", "minimum": 0, "maximum": 1 },
                "high": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "bandMedian": { "type": ["number", "null"] },
        "bandP40": { "type": ["number", "null"] },
        "percentile": { "type": ["number", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "excess": { "type": "number", "minimum": 0 },
        "trainability": { "type": "number" },
        "priority": { "type": "number", "minimum": 0 },
        "precise": { "type": "boolean" },
        "minEvidenceMet": { "type": "boolean" },
        "reason": { "enum": ["ok", "no_benchmark", "insufficient_data", "no_events"] },
        "credible": { "type": "boolean" },
        "modelBaseline": { "type": "boolean" },
        "invalidPoints": { "$ref": "#/$defs/Count" }
      }
    },
    "PlayerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "now", "band", "games_in_window", "estimates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "now": { "$ref": "#/$defs/Time" },
        "band": { "$ref": "#/$defs/Band" },
        "games_in_window": { "$ref": "#/$defs/Count" },
        "estimates": { "type": "array", "items": { "$ref": "#/$defs/WeaknessEstimate" } },
        "outcomes": { "$ref": "#/$defs/Outcomes" }
      }
    },
    "RankedWeakness": {
      "description": "The CoachingInput's RankedWeakness (backend/crates/coaching-input), with no exemplars. The full field rules are in that crate's schema; these are the ones the lab reads.",
      "type": "object",
      "required": [
        "id",
        "rank",
        "posteriorRate",
        "intervalLow",
        "intervalHigh",
        "bandMedian",
        "confidence",
        "priority",
        "state",
        "events",
        "opportunities"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^W[0-9]+[a-d]?$" },
        "variant": { "type": ["string", "null"] },
        "rank": { "type": "integer", "minimum": 1 },
        "posteriorRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "intervalLow": { "type": "number", "minimum": 0, "maximum": 1 },
        "intervalHigh": { "type": "number", "minimum": 0, "maximum": 1 },
        "bandMedian": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "priority": { "type": "number", "exclusiveMinimum": 0 },
        "state": { "$ref": "#/$defs/WeaknessState" },
        "events": { "$ref": "#/$defs/Count" },
        "opportunities": { "$ref": "#/$defs/Count" },
        "exemplars": { "type": "array", "maxItems": 0 }
      }
    },
    "DrillLists": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "PlayerRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ranked", "drills", "focuses", "focus_drills"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ranked": { "type": "array", "items": { "$ref": "#/$defs/RankedWeakness" } },
        "drills": { "$ref": "#/$defs/DrillLists" },
        "focuses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "focus_drills": { "$ref": "#/$defs/DrillLists" }
      }
    },
    "LabGame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pgn",
        "played_at",
        "player_color",
        "white_name",
        "black_name",
        "white_rating",
        "black_rating",
        "result",
        "termination",
        "base_seconds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pgn": { "type": "string", "minLength": 1 },
        "played_at": { "$ref": "#/$defs/Time" },
        "player_color": { "enum": ["white", "black"] },
        "white_name": { "type": "string" },
        "black_name": { "type": "string" },
        "white_rating": { "type": "integer" },
        "black_rating": { "type": "integer" },
        "result": { "enum": ["1-0", "0-1", "1/2-1/2"] },
        "termination": { "type": "string" },
        "base_seconds": { "type": "integer", "minimum": 0 },
        "increment_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "PlayerCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "analysed_games", "profile_matches_build", "mismatches"],
      "properties": {
        "id": { "type": "string" },
        "analysed_games": { "$ref": "#/$defs/Count" },
        "profile_matches_build": { "type": "boolean" },
        "mismatches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AnalyseRequest": {
      "type": "object",
      "required": ["schema_version", "players"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "nodes": { "type": ["integer", "null"], "minimum": 1 },
        "engines": { "type": ["integer", "null"], "minimum": 1 },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "games"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "now": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Time" }] },
              "games": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/LabGame" } }
            }
          }
        }
      }
    },
    "AnalyseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "nodes", "players", "checks"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "nodes": { "type": "integer", "minimum": 1 },
        "players": { "type": "array", "items": { "$ref": "#/$defs/PlayerFacts" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/PlayerCheck" } }
      }
    },
    "ProfileRequest": {
      "description": "Facts; an AnalyseResponse is one (its nodes and checks are ignored).",
      "type": "object",
      "required": ["schema_version", "players"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/AlgorithmId" }] },
        "players": { "type": "array", "items": { "$ref": "#/$defs/PlayerFacts" } }
      }
    },
    "ProfileResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "players"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "players": { "type": "array", "items": { "$ref": "#/$defs/PlayerProfile" } }
      }
    },
    "RankRequest": {
      "description": "Profiles; a ProfileResponse is one.",
      "type": "object",
      "required": ["schema_version", "players"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/AlgorithmId" }] },
        "first_report": { "type": "boolean" },
        "players": { "type": "array", "items": { "$ref": "#/$defs/PlayerProfile" } }
      }
    },
    "RankResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "players"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "players": { "type": "array", "items": { "$ref": "#/$defs/PlayerRanking" } }
      }
    },
    "MotifTag": {
      "description": "A motif tag as the product stores it (MotifTag::as_str, profile-core).",
      "enum": [
        "hangingPiece",
        "fork",
        "pin",
        "skewer",
        "discoveredAttack",
        "deflection",
        "sacrifice",
        "promotion",
        "mate",
        "mateIn1",
        "mateIn2",
        "mateIn3",
        "mateIn4Plus",
        "matingNet",
        "backRankMate",
        "smotheredMate"
      ]
    },
    "LineAnalysis": {
      "description": "The algorithm's LineAnalysis (camelCase): the settled swing and the motif tags.",
      "type": "object",
      "additionalProperties": false,
      "required": ["gain", "depth", "mateIn", "tags"],
      "properties": {
        "gain": { "type": "number" },
        "depth": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Count" }] },
        "mateIn": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Count" }] },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/MotifTag" } }
      }
    },
    "MotifLine": {
      "description": "A line to tag: setup is played from fen to reach the tagged position, then pv is the mover's best line.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fen", "pv"],
      "properties": {
        "id": { "type": "string" },
        "fen": { "type": "string" },
        "setup": { "type": "array", "items": { "type": "string" } },
        "pv": { "type": "array", "items": { "type": "string" } }
      }
    },
    "TaggedLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fen", "pov", "best"],
      "properties": {
        "id": { "type": "string" },
        "fen": { "type": ["string", "null"] },
        "pov": { "oneOf": [{ "type": "null" }, { "enum": ["white", "black"] }] },
        "best": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/LineAnalysis" }] }
      }
    },
    "TagMotifsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "lines"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/MotifLine" } }
      }
    },
    "TagMotifsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "lines"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/TaggedLine" } }
      }
    },
    "EngineScore": {
      "description": "An engine score: exactly one of cp (centipawns) or mate (moves, negative when the side is mated).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cp"],
          "properties": { "cp": { "type": "integer" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mate"],
          "properties": { "mate": { "type": "integer" } }
        }
      ]
    },
    "DepthGame": {
      "description": "A game for positions or judge (EXP-0008); lichess_evals is Lichess's evaluation after each ply, White's point of view, as production stores it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pgn"],
      "properties": {
        "id": { "type": "string" },
        "pgn": { "type": "string" },
        "base_seconds": { "type": ["integer", "null"] },
        "increment_seconds": { "type": ["integer", "null"] },
        "lichess_evals": {
          "type": ["array", "null"],
          "items": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/EngineScore" }] }
        }
      }
    },
    "PositionsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "games"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "games": { "type": "array", "items": { "$ref": "#/$defs/DepthGame" } }
      }
    },
    "GamePositions": {
      "description": "The FENs evaluate_game asks the engine for, in its order, each once; sequence is, for each of the plies + 1 positions, the FEN whose search scores it, or null for a final position scored without one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "plies", "terminal", "fens", "sequence"],
      "properties": {
        "id": { "type": "string" },
        "plies": { "$ref": "#/$defs/Count" },
        "terminal": { "type": "boolean" },
        "fens": { "type": "array", "items": { "type": "string" } },
        "sequence": { "type": "array", "items": { "type": ["string", "null"] } }
      }
    },
    "PositionsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "games"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "games": { "type": "array", "items": { "$ref": "#/$defs/GamePositions" } }
      }
    },
    "EvaluateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "nodes", "fens"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "nodes": { "type": "integer", "minimum": 1 },
        "hash_mb": { "type": ["integer", "null"], "minimum": 1, "maximum": 4096 },
        "syzygy": { "type": "boolean" },
        "engines": { "type": ["integer", "null"], "minimum": 1 },
        "fens": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Search": {
      "description": "One search as evaluate_game reads it: the last complete MultiPV 1 line, the side to move's score. cpu_ms is for costing only and is not deterministic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fen", "score", "best_uci", "depth", "nodes", "cpu_ms"],
      "properties": {
        "fen": { "type": "string" },
        "score": { "$ref": "#/$defs/EngineScore" },
        "best_uci": { "type": ["string", "null"] },
        "depth": { "$ref": "#/$defs/Count" },
        "nodes": { "type": "integer", "minimum": 0 },
        "cpu_ms": { "type": ["number", "null"] }
      }
    },
    "EvaluateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm_id",
        "nodes",
        "hash_mb",
        "syzygy",
        "threads",
        "searches"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "nodes": { "type": "integer", "minimum": 1 },
        "hash_mb": { "type": "integer", "minimum": 1 },
        "syzygy": { "type": "boolean" },
        "threads": { "type": "integer", "minimum": 1 },
        "searches": { "type": "array", "items": { "$ref": "#/$defs/Search" } }
      }
    },
    "GivenSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fen", "score"],
      "properties": {
        "fen": { "type": "string" },
        "score": { "$ref": "#/$defs/EngineScore" },
        "best_uci": { "type": ["string", "null"] }
      }
    },
    "JudgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "games", "searches"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "games": { "type": "array", "items": { "$ref": "#/$defs/DepthGame" } },
        "searches": { "type": "array", "items": { "$ref": "#/$defs/GivenSearch" } }
      }
    },
    "JudgedMove": {
      "description": "One move as the analyse-game job stores it in move_records.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ply",
        "color",
        "uci",
        "best_uci",
        "win_before",
        "win_after",
        "accuracy",
        "judgement",
        "decided"
      ],
      "properties": {
        "ply": { "$ref": "#/$defs/Count" },
        "color": { "enum": ["white", "black"] },
        "uci": { "type": "string" },
        "best_uci": { "type": ["string", "null"] },
        "win_before": { "type": "number" },
        "win_after": { "type": "number" },
        "accuracy": { "type": "number" },
        "judgement": {
          "oneOf": [{ "type": "null" }, { "enum": ["inaccuracy", "mistake", "blunder"] }]
        },
        "decided": { "type": "boolean" }
      }
    },
    "JudgedGame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "moves", "accuracy_white", "accuracy_black", "lichess_used"],
      "properties": {
        "id": { "type": "string" },
        "moves": { "type": "array", "items": { "$ref": "#/$defs/JudgedMove" } },
        "accuracy_white": { "type": "number" },
        "accuracy_black": { "type": "number" },
        "lichess_used": { "$ref": "#/$defs/Count" }
      }
    },
    "JudgeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "games"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "games": { "type": "array", "items": { "$ref": "#/$defs/JudgedGame" } }
      }
    },
    "ObserveGame": {
      "description": "A Lichess game for observe (EXP-0009): Lichess's evaluation after each ply, White's point of view, and the sides to observe.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pgn", "base_seconds", "increment_seconds", "lichess_evals", "sides"],
      "properties": {
        "id": { "type": "string" },
        "pgn": { "type": "string" },
        "base_seconds": { "type": "integer", "minimum": 0 },
        "increment_seconds": { "type": "integer", "minimum": 0 },
        "lichess_evals": {
          "type": "array",
          "items": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/EngineScore" }] }
        },
        "sides": { "type": "array", "items": { "enum": ["white", "black"] } },
        "white_rating": { "type": ["integer", "null"] },
        "black_rating": { "type": ["integer", "null"] },
        "termination": { "type": ["string", "null"] }
      }
    },
    "ObserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "games", "searches"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "games": { "type": "array", "items": { "$ref": "#/$defs/ObserveGame" } },
        "searches": { "type": "array", "items": { "$ref": "#/$defs/GivenSearch" } }
      }
    },
    "KeyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "opportunities"],
      "properties": {
        "events": { "$ref": "#/$defs/Count" },
        "opportunities": { "$ref": "#/$defs/Count" }
      }
    },
    "ObservedSide": {
      "description": "One side of an observed game: its accuracy, judgement counts and the keys whose detectors need no enrichment (bench::observe::EVAL_ONLY_KEYS) with at least one opportunity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "accuracy", "moves", "inaccuracies", "mistakes", "blunders", "keys"],
      "properties": {
        "color": { "enum": ["white", "black"] },
        "accuracy": { "type": ["number", "null"] },
        "moves": { "$ref": "#/$defs/Count" },
        "inaccuracies": { "$ref": "#/$defs/Count" },
        "mistakes": { "$ref": "#/$defs/Count" },
        "blunders": { "$ref": "#/$defs/Count" },
        "keys": {
          "type": "object",
          "propertyNames": {
            "enum": ["W4.missed", "W4.allowed", "W5", "W6", "W7.traps", "W7.prep", "W9a", "W9b"]
          },
          "additionalProperties": { "$ref": "#/$defs/KeyCount" }
        }
      }
    },
    "ObservedGame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "error", "sides"],
      "properties": {
        "id": { "type": "string" },
        "error": { "type": ["string", "null"] },
        "sides": { "type": "array", "items": { "$ref": "#/$defs/ObservedSide" } }
      }
    },
    "ObserveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm_id", "games"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "algorithm_id": { "$ref": "#/$defs/AlgorithmId" },
        "games": { "type": "array", "items": { "$ref": "#/$defs/ObservedGame" } }
      }
    }
  }
}
