{
  "name": "chess-improver",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "shots": "tsx scripts/shots.ts",
    "design:check": "tsx scripts/ban-lint.ts",
    "e2e": "pnpm --filter @ci/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
