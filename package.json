{
  "name": "chess-improver",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "shots": "tsx scripts/shots.ts",
    "design:check": "tsx scripts/ban-lint.ts",
    "e2e": "pnpm --filter @ci/web e2e",
    "seed:demo": "sh scripts/seed-demo.sh",
    "setup": "sh scripts/setup.sh",
    "test:setup": "sh scripts/test-setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
